ARG JAVA_IMAGE=eclipse-temurin:17-jre-jammy
FROM ${JAVA_IMAGE} AS java
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SPARK_LOCAL_IP=127.0.0.1
COPY --from=java /opt/java/openjdk /opt/java/openjdk
WORKDIR /app
COPY requirements.lock requirements-spark.lock pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements.lock -r requirements-spark.lock \
    && pip install --no-deps . && useradd --uid 10001 --create-home pipeline \
    && mkdir /state && chown pipeline:pipeline /state \
    && python -m pip uninstall -y pip setuptools wheel
USER 10001:10001
ENTRYPOINT ["python", "-m", "pipefoundry.worker"]
