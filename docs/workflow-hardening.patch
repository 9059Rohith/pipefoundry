diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 4c08c68..13d33af 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -25,10 +25,12 @@ jobs:
       PIPEFOUNDRY_TEST_SPARK: '1'
       SPARK_LOCAL_IP: 127.0.0.1
     steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-python@v5
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
         with: {python-version: '3.12', cache: pip}
-      - uses: actions/setup-java@v4
+      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
         with: {distribution: temurin, java-version: '17'}
       - run: python -m pip install -r requirements-dev.lock -r requirements-spark.lock
       - run: python -m pip install --no-deps -e .
@@ -40,20 +42,22 @@ jobs:
       - run: python -m pytest -q --junitxml=evidence/ci-tests.xml
       - run: python scripts/benchmark.py --samples 30 --execution-samples 10 --output evidence/ci-benchmark.json
       - run: python -m build --wheel --no-isolation
-      - uses: actions/upload-artifact@v4
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
         if: always()
         with: {name: python-evidence, path: evidence/ci-*}
   deployment-artifacts:
     runs-on: ubuntu-latest
     timeout-minutes: 20
     steps:
-      - uses: actions/checkout@v4
-      - uses: hashicorp/setup-terraform@v3
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          persist-credentials: false
+      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3
         with: {terraform_version: '1.13.5'}
       - run: terraform -chdir=infra/terraform fmt -check -recursive
       - run: terraform -chdir=infra/terraform init -backend=false -input=false
       - run: terraform -chdir=infra/terraform validate
-      - uses: azure/setup-helm@v4.3.0
+      - uses: azure/setup-helm@b9e51907a09c216f16ebe8536097933489208112 # v4.3.0
         with: {version: v3.17.3}
       - run: helm lint infra/helm/pipefoundry
       - run: helm template pipefoundry infra/helm/pipefoundry > evidence/ci-helm.yaml
@@ -67,6 +71,6 @@ jobs:
           --format json --output /evidence/ci-image-scan.json
       - run: rm evidence/ci-image.tar
       - run: docker run --rm --read-only --tmpfs /tmp pipefoundry:ci python -c 'from pipefoundry.worker import run; from pipefoundry.models import Pipeline; import tempfile; from pathlib import Path; c=Pipeline.model_validate({"name":"ci","schedule":"0 * * * *"}); r=run(c,Path(tempfile.mkdtemp())); assert r["total_rows"]==3; print(r)'
-      - uses: actions/upload-artifact@v4
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
         if: always()
         with: {name: deployment-evidence, path: evidence/ci-*}
